{
  "manifest_version": 2,
  "name": "Downloader Safari Extension",
  "version": "1.1.1",
  "description": "Send links from Safari to Downloader.",
  "default_locale": "en",
  "icons": {
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "permissions": ["contextMenus", "nativeMessaging", "tabs", "webNavigation", "<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
